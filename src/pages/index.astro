---
import { getRelativeLocaleUrl } from "astro:i18n";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Socials from "@/components/Socials.astro";
import LinkButton from "@/components/LinkButton.astro";
import config from "@/config";

const { socials } = config;
const locale = Astro.currentLocale ?? config.site.lang;

// 首页呈现的诗词（呼应你的名字 midsummer-q · 盛夏时光）
// 你可以随时在此修改为你喜爱的任意诗歌
const poem = {
  title: "夏意",
  author: "苏舜钦",
  dynasty: "宋",
  lines: [
    "别院深深夏席清，",
    "石榴开遍透帘明。",
    "树阴满地日当午，",
    "梦觉流莺时一声。"
  ],
  quote: "万物繁茂，静听风吟。"
};
---

<Layout>
  <Header />

  <main
    id="main-content"
    class="app-layout flex min-h-[calc(100vh-180px)] flex-col items-center justify-center py-12"
  >
    <div class="w-full max-w-xl text-center">
      <!-- 诗歌展示核心卡片区 -->
      <section class="relative py-8 sm:py-14">
        <!-- 诗词徽标 -->
        <div class="mb-6 inline-flex items-center gap-2 rounded-full border border-border/80 bg-muted/40 px-3.5 py-1 text-xs text-muted-foreground font-mono">
          <span class="size-1.5 rounded-full bg-accent animate-pulse"></span>
          <span>Midsummer · 诗意栖居</span>
        </div>

        <!-- 诗词标题与作者 -->
        <h1 class="text-2xl font-bold tracking-widest text-foreground sm:text-3xl font-serif">
          {poem.title}
        </h1>
        <p class="mt-2 text-sm text-muted-foreground font-serif tracking-widest">
          〔{poem.dynasty}〕{poem.author}
        </p>

        <!-- 诗词正文行 -->
        <div class="my-8 space-y-3.5 font-serif text-lg leading-relaxed text-foreground/90 sm:text-xl tracking-widest">
          {poem.lines.map(line => (
            <p class="transition-colors hover:text-accent cursor-default">{line}</p>
          ))}
        </div>

        <!-- 心境附言 -->
        {poem.quote && (
          <p class="mt-8 text-xs text-muted-foreground/75 italic font-mono tracking-wider">
            —— {poem.quote}
          </p>
        )}

        <!-- 极简引导入口 -->
        <div class="mt-10">
          <LinkButton
            href={getRelativeLocaleUrl(locale, "posts")}
            class="group inline-flex items-center gap-1.5 rounded-full border border-border px-5 py-2 text-sm text-foreground/80 hover:text-accent hover:border-accent transition-all shadow-sm hover:shadow"
          >
            <span>进入文章列表</span>
            <IconArrowRight class="inline-block size-4 transition-transform group-hover:translate-x-0.5 rtl:-rotate-180" />
          </LinkButton>
        </div>
      </section>

      <!-- 社交账号 -->
      {socials.length > 0 && (
        <div class="mt-4 flex justify-center border-t border-border/40 pt-6">
          <Socials />
        </div>
      )}
    </div>
  </main>

  <Footer />
</Layout>
