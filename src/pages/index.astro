---
import { getRelativeLocaleUrl } from "astro:i18n";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import config from "@/config";

const locale = Astro.currentLocale ?? config.site.lang;

const literaryPiece = {
  engSeries: "JAMES JOYCE  /  THE DEAD",
  title: "死者",
  authorSource: "詹姆斯·乔伊斯 · 《都柏林人》",
  paragraphs: [
    "窗玻璃上几声轻微的敲击声使他转向窗户。又开始下雪了。他睡意朦胧地望着银白与暗影交织的雪花，斜斜地飘落在路灯的光晕里。是时候启程西行了。",
    "是的，报纸说得对：整个爱尔兰都在下雪。雪花飘落在黑暗的中央平原的每寸土地，飘落在无树的丘陵，轻柔地覆盖艾伦沼泽，再向西，轻轻地落入香农河幽暗的逆浪中。",
    "雪花也落在山丘上那座孤寂教堂墓园的每个角落，迈克尔·富里就安息在那里。雪堆积在歪斜的十字架与墓碑上，堆积在小门栏的铁矛尖上，堆积在荒芜的荆棘丛中。",
    "他的灵魂渐渐陷入昏沉，听见雪花穿越寰宇隐隐飘落，如同宿命的终章般，轻轻落在所有生者与逝者之上。"
  ],
  quote: "“Falling faintly through the universe and faintly falling, upon all the living and the dead.”",
  quoteAuthor: "— James Joyce, The Dead"
};
---

<Layout>
  <Header />

  <main
    id="main-content"
    class="app-layout flex min-h-[calc(100vh-160px)] flex-col items-center justify-center py-10 sm:py-16"
  >
    <!-- 正文严格控制在 600-620px 黄金阅读栏宽 -->
    <article class="w-full max-w-editorial mx-auto px-2">
      
      <!-- 三层式标题区域 -->
      <header class="text-center pt-2 pb-8 sm:pb-10">
        <!-- 第一层：小字号大写英文作品信息 -->
        <p class="font-mono text-[11px] sm:text-[12px] uppercase tracking-[0.2em] text-muted-foreground/85 select-none">
          {literaryPiece.engSeries}
        </p>

        <!-- 第二层：视觉中心中文标题（34-38px，字重 400-500，细雅宋体） -->
        <h1 class="font-serif text-[34px] sm:text-[38px] font-normal tracking-[0.16em] text-foreground mt-3 mb-2.5">
          {literaryPiece.title}
        </h1>

        <!-- 第三层：淡灰色来源 -->
        <p class="font-serif text-[13px] sm:text-[14px] text-muted-foreground/75 tracking-wider">
          {literaryPiece.authorSource}
        </p>

        <!-- 极细中置短横线，全页仅此一处 -->
        <div class="w-7 h-[1px] bg-border mx-auto mt-6" aria-hidden="true"></div>
      </header>

      <!-- 经典正文排版（严格遵循出版级参数：字号 16-16.5px，行高 1.98，字距 0.02em，段距 24px，缩进 2em） -->
      <div class="font-serif text-[16px] sm:text-[16.5px] leading-[1.98] tracking-[0.02em] text-foreground/90 text-left sm:text-justify space-y-6">
        {literaryPiece.paragraphs.map(p => (
          <p class="indent-[2em]">{p}</p>
        ))}
      </div>

      <!-- 英文引用区域（收束文章，对比度适宜，字号 13-14px） -->
      <footer class="mt-12 sm:mt-14 pt-8 border-t border-border/40 text-center font-serif">
        <blockquote class="italic text-[13px] sm:text-[14px] leading-relaxed text-muted-foreground tracking-wide">
          {literaryPiece.quote}
        </blockquote>
        <p class="font-mono text-[11px] sm:text-[12px] text-muted-foreground/70 mt-2 tracking-wider">
          {literaryPiece.quoteAuthor}
        </p>

        <!-- 独立杂志式文字链接（克制、无阴影、悬停轻微移动与颜色渐变） -->
        <div class="mt-10 mb-2">
          <a
            href={getRelativeLocaleUrl(locale, "posts")}
            class="group inline-flex items-center gap-1.5 font-mono text-[13px] sm:text-[14px] text-foreground hover:text-accent transition-colors duration-200"
          >
            <span class="hover:underline hover:underline-offset-4 decoration-foreground/30">浏览全部文章</span>
            <span class="inline-block transition-transform duration-200 group-hover:translate-x-1">→</span>
          </a>
        </div>
      </footer>
    </article>
  </main>

  <Footer />
</Layout>
