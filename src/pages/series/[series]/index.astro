---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import { getUniqueSeries, getPostsBySeries } from "@/utils/getSeries";
import config from "@/config";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  const seriesList = getUniqueSeries(posts);

  return seriesList.map(series => {
    const seriesPosts = getPostsBySeries(posts, series.name);
    return {
      params: { series: series.slug },
      props: {
        seriesName: series.name,
        posts: seriesPosts,
      },
    };
  });
}

const { seriesName, posts } = Astro.props;
---

<Layout title={`专栏：${seriesName} | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle={`专栏：${seriesName}`}
    pageDesc={`收录于《${seriesName}》专题的系列文章（共 ${posts.length} 篇）。`}
  >
    <ul>
      {posts.map(post => <Card {...post} />)}
    </ul>
  </Main>

  <Footer />
</Layout>
