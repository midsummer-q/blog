---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import Footer from "@/components/Footer.astro";
import { getUniqueSeries } from "@/utils/getSeries";
import config from "@/config";

const posts = await getCollection("posts", ({ data }) => !data.draft);
const seriesList = getUniqueSeries(posts);

const locale = Astro.currentLocale ?? config.site.lang;
const baseUrl = import.meta.env.BASE_URL.replace(/\/+$/, "");
---

<Layout title={`专栏系列 | ${config.site.title}`}>
  <Header />

  <Breadcrumb />

  <Main
    pageTitle="专栏系列"
    pageDesc="按技术专题与思考脉络归类的系列文章集合。"
  >
    {
      seriesList.length === 0 ? (
        <div class="border-border/70 text-muted-foreground my-8 rounded-lg border border-dashed p-8 text-center">
          <p class="text-base">暂无专栏系列文章</p>
          <p class="mt-2 text-xs">
            在文章 frontmatter 中添加 <code>series: "系列名称"</code>{" "}
            即可创建专栏。
          </p>
        </div>
      ) : (
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {seriesList.map(series => (
            <li class="group border-border/60 hover:border-accent hover:bg-accent/5 relative rounded-lg border p-5 transition-all duration-200">
              <a href={`${baseUrl}/series/${series.slug}/`} class="block">
                <div class="flex items-center justify-between">
                  <span class="text-accent text-xs font-semibold tracking-wider uppercase">
                    专栏
                  </span>
                  <span class="text-muted-foreground text-xs">
                    {series.count} 篇文章
                  </span>
                </div>
                <h2 class="text-foreground group-hover:text-accent mt-2 text-lg font-bold transition-colors">
                  {series.name}
                </h2>
                <div class="text-muted-foreground mt-3 flex items-center justify-between text-xs">
                  <span>
                    最近更新:{" "}
                    {series.latestDate.toLocaleDateString(locale, {
                      year: "numeric",
                      month: "short",
                      day: "numeric",
                    })}
                  </span>
                  <span class="text-accent transition-transform group-hover:translate-x-1">
                    浏览全部 &rarr;
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </Main>

  <Footer />
</Layout>
