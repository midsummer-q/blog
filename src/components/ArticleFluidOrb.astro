---
// ArticleFluidOrb.astro - 全篇非侵入式流体光晕交互引擎（零排版重排、零内容挤压）
---

<div id="fluid-spotlight-orb" class="fluid-spotlight-orb" aria-hidden="true">
  <div class="spotlight-core"></div>
  <div class="spotlight-aura"></div>
</div>

<style>
  .fluid-spotlight-orb {
    position: absolute;
    top: 0;
    left: 0;
    width: 200px;
    height: 200px;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    opacity: 0;
    will-change: transform, opacity;
    transition: opacity 0.5s ease-out;
  }

  .spotlight-core {
    position: absolute;
    inset: 15%;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(0, 108, 172, 0.45) 0%, rgba(99, 102, 241, 0.25) 55%, transparent 75%);
    filter: blur(28px);
    mix-blend-mode: multiply;
  }

  :global(.dark) .spotlight-core,
  :global([data-theme="dark"]) .spotlight-core {
    background: radial-gradient(circle, rgba(255, 107, 1, 0.5) 0%, rgba(168, 85, 247, 0.3) 55%, transparent 75%);
    mix-blend-mode: screen;
  }

  .spotlight-aura {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(139, 92, 246, 0.2) 0%, transparent 65%);
    filter: blur(40px);
    animation: aura-breathe 4s ease-in-out infinite alternate;
  }

  :global(.dark) .spotlight-aura,
  :global([data-theme="dark"]) .spotlight-aura {
    background: radial-gradient(circle, rgba(236, 72, 153, 0.2) 0%, transparent 65%);
  }

  @keyframes aura-breathe {
    0% { transform: scale(0.92); opacity: 0.7; }
    100% { transform: scale(1.12); opacity: 1; }
  }

  /* 保证文章内所有文本、表格和代码块位于光晕上层且层次分明 */
  :global(#article > *) {
    position: relative;
    z-index: 1;
  }
</style>

<script>
  function initFluidSpotlight() {
    const orb = document.getElementById("fluid-spotlight-orb");
    const article = document.getElementById("article");
    if (!orb || !article) return;

    const orbEl: HTMLElement = orb;
    const articleEl: HTMLElement = article;

    let targetX = 150;
    let targetY = 100;
    let curX = 150;
    let curY = 100;
    let isHovering = false;
    let isIdle = true;

    // 自主轻柔漫游速度
    let floatAngle = 0;

    function onPointerMove(e: MouseEvent | TouchEvent) {
      isHovering = true;
      isIdle = false;
      orbEl.style.opacity = "1";

      const rect = articleEl.getBoundingClientRect();
      let cx = 0;
      let cy = 0;

      if ("touches" in e) {
        if (e.touches.length > 0) {
          cx = e.touches[0].clientX;
          cy = e.touches[0].clientY;
        }
      } else {
        cx = e.clientX;
        cy = e.clientY;
      }

      targetX = cx - rect.left;
      targetY = cy - rect.top;
    }

    function onPointerLeave() {
      isHovering = false;
      // 鼠标移出后温柔淡化但继续保持轻柔呼吸
      orbEl.style.opacity = "0.6";
    }

    articleEl.addEventListener("mousemove", onPointerMove);
    articleEl.addEventListener("touchmove", onPointerMove, { passive: true });
    articleEl.addEventListener("mouseenter", () => {
      orbEl.style.opacity = "1";
    });
    articleEl.addEventListener("mouseleave", onPointerLeave);

    // 读者滚动页面时，光晕平滑伴随阅读视口
    window.addEventListener("scroll", () => {
      if (!isHovering) {
        const rect = articleEl.getBoundingClientRect();
        if (rect.top < window.innerHeight && rect.bottom > 0) {
          const viewY = Math.max(60, window.innerHeight * 0.35 - rect.top);
          targetY = Math.min(viewY, articleEl.clientHeight - 100);
        }
      }
    }, { passive: true });

    // 60FPS GPU 硬件加速渲染循环（只变换 translate3d，绝不引发任何回流重排）
    function render() {
      if (!document.body.contains(orbEl)) return;

      if (isIdle && !isHovering) {
        floatAngle += 0.025;
        targetX = articleEl.clientWidth / 2 + Math.cos(floatAngle) * 80;
      }

      // 平滑缓动插值（弹性流体质感）
      curX += (targetX - curX) * 0.12;
      curY += (targetY - curY) * 0.12;

      // translate3d(x, y, 0) 让 GPU 单独合成层处理，零 DOM 几何重绘
      const x = Math.round(curX - 100);
      const y = Math.round(curY - 100);
      orbEl.style.transform = `translate3d(${x}px, ${y}px, 0)`;

      requestAnimationFrame(render);
    }

    orbEl.style.opacity = "0.75";
    requestAnimationFrame(render);
  }

  document.addEventListener("astro:page-load", initFluidSpotlight);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initFluidSpotlight);
  } else {
    initFluidSpotlight();
  }
</script>
