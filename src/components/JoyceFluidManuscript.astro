---
// JoyceFluidManuscript.astro - 基于 @chenglou/pretext 槽位雕刻算法实现的全篇文字避障流体排版
interface Props {
  paragraphs: string[];
}

const { paragraphs } = Astro.props;
const jsonParagraphs = JSON.stringify(paragraphs);
---

<div class="joyce-fluid-container relative w-full select-none" data-paragraphs={jsonParagraphs}>
  <!-- 纯净画布：固定版心宽度与高度，零外部重排下推 -->
  <canvas id="joyce-canvas" class="block w-full touch-none cursor-grab active:cursor-grabbing"></canvas>
  <div class="mt-2 text-center text-[11px] font-mono text-muted-foreground/60 select-none">
    ✦ 轻触或移动光标，光华在字里行间流转避让 ✦
  </div>
</div>

<script>
  import {
    prepareWithSegments,
    layoutNextLine,
    type LayoutCursor,
    type PreparedTextWithSegments,
  } from "@chenglou/pretext";

  type Interval = { left: number; right: number };

  function circleIntervalForBand(
    cx: number,
    cy: number,
    r: number,
    bandTop: number,
    bandBottom: number,
    hPad: number = 10,
    vPad: number = 4
  ): Interval | null {
    const top = bandTop - vPad;
    const bottom = bandBottom + vPad;
    if (top >= cy + r || bottom <= cy - r) return null;
    const minDy = cy >= top && cy <= bottom ? 0 : cy < top ? top - cy : cy - bottom;
    if (minDy >= r) return null;
    const maxDx = Math.sqrt(r * r - minDy * minDy);
    return { left: cx - maxDx - hPad, right: cx + maxDx + hPad };
  }

  function carveTextLineSlots(base: Interval, blocked: Interval[], minWidth: number = 40): Interval[] {
    let slots: Interval[] = [base];
    for (let i = 0; i < blocked.length; i++) {
      const interval = blocked[i]!;
      const next: Interval[] = [];
      for (let j = 0; j < slots.length; j++) {
        const slot = slots[j]!;
        if (interval.right <= slot.left || interval.left >= slot.right) {
          next.push(slot);
          continue;
        }
        if (interval.left > slot.left) next.push({ left: slot.left, right: interval.left });
        if (interval.right < slot.right) next.push({ left: interval.right, right: slot.right });
      }
      slots = next;
    }
    return slots.filter(slot => slot.right - slot.left >= minWidth);
  }

  function initJoyceManuscript() {
    const container = document.querySelector(".joyce-fluid-container") as HTMLElement | null;
    const canvas = document.getElementById("joyce-canvas") as HTMLCanvasElement | null;
    if (!container || !canvas) return;

    const box: HTMLElement = container;
    const cvs: HTMLCanvasElement = canvas;

    const ctx = cvs.getContext("2d");
    if (!ctx) return;
    const renderCtx: CanvasRenderingContext2D = ctx;

    const rawData = box.dataset.paragraphs || "[]";
    const paragraphsList: string[] = JSON.parse(rawData);

    // 标准出版级排版参数
    const font = '16.5px "Noto Serif SC", "Source Han Serif SC", "Songti SC", Georgia, Cambria, serif';
    const lineHeight = 33;
    const paragraphGap = 22;
    const orbRadius = 46;

    // 预解析每个段落（首行缩进两个全角空格）
    const preparedParagraphs: PreparedTextWithSegments[] = paragraphsList.map(text =>
      prepareWithSegments("　　" + text.trim(), font)
    );

    // 灵动光球物理状态
    let ballX = 180;
    let ballY = 120;
    let targetX = 180;
    let targetY = 120;
    let isUserInteracting = false;
    let idleAngle = 0;
    let vx = 1.3;
    let vy = 0.9;

    let width = 600;
    let height = 460;

    function resize() {
      const rect = box.getBoundingClientRect();
      width = Math.min(rect.width || 600, 620);
      
      // 自适应计算高度（手机端行数增多时适当提升高度）
      height = width < 480 ? 560 : width < 560 ? 500 : 450;

      const dpr = Math.min(window.devicePixelRatio || 1, 2);
      cvs.width = width * dpr;
      cvs.height = height * dpr;
      cvs.style.width = `${width}px`;
      cvs.style.height = `${height}px`;

      renderCtx.scale(dpr, dpr);

      if (ballX > width - orbRadius) ballX = width / 2;
      if (ballY > height - orbRadius) ballY = height / 2;
    }

    resize();
    window.addEventListener("resize", resize);

    function onPointerMove(e: MouseEvent | TouchEvent) {
      isUserInteracting = true;
      const rect = cvs.getBoundingClientRect();
      let cx = 0;
      let cy = 0;
      if ("touches" in e) {
        if (e.touches.length > 0) {
          cx = e.touches[0].clientX;
          cy = e.touches[0].clientY;
        }
      } else {
        cx = e.clientX;
        cy = e.clientY;
      }
      targetX = Math.max(orbRadius, Math.min(cx - rect.left, width - orbRadius));
      targetY = Math.max(orbRadius, Math.min(cy - rect.top, height - orbRadius));
    }

    cvs.addEventListener("mousemove", onPointerMove);
    cvs.addEventListener("touchmove", onPointerMove, { passive: true });
    cvs.addEventListener("mouseleave", () => { isUserInteracting = false; });
    cvs.addEventListener("touchend", () => { isUserInteracting = false; });

    function render() {
      if (!document.body.contains(cvs)) return;

      const isDark = document.documentElement.classList.contains("dark") ||
                     document.documentElement.getAttribute("data-theme") === "dark";

      // 物理巡航或平滑跟随
      if (!isUserInteracting) {
        idleAngle += 0.02;
        ballX += Math.cos(idleAngle * 0.7) * 1.5 + vx * 0.4;
        ballY += Math.sin(idleAngle) * 1.1 + vy * 0.3;

        // 碰撞柔和反弹
        if (ballX - orbRadius < 10) { ballX = orbRadius + 10; vx = Math.abs(vx); }
        if (ballX + orbRadius > width - 10) { ballX = width - orbRadius - 10; vx = -Math.abs(vx); }
        if (ballY - orbRadius < 10) { ballY = orbRadius + 10; vy = Math.abs(vy); }
        if (ballY + orbRadius > height - 10) { ballY = height - orbRadius - 10; vy = -Math.abs(vy); }
      } else {
        ballX += (targetX - ballX) * 0.16;
        ballY += (targetY - ballY) * 0.16;
      }

      renderCtx.clearRect(0, 0, width, height);

      // 1. 绘制发光灵兽/光晕（中世纪泥金手抄本古典金光质感）
      const grad = renderCtx.createRadialGradient(
        ballX - orbRadius * 0.25,
        ballY - orbRadius * 0.25,
        orbRadius * 0.08,
        ballX,
        ballY,
        orbRadius
      );

      if (isDark) {
        grad.addColorStop(0, "rgba(235, 175, 95, 0.95)");
        grad.addColorStop(0.5, "rgba(215, 120, 50, 0.65)");
        grad.addColorStop(0.85, "rgba(140, 70, 180, 0.25)");
        grad.addColorStop(1, "rgba(23, 25, 27, 0)");
      } else {
        grad.addColorStop(0, "rgba(230, 160, 45, 0.95)");
        grad.addColorStop(0.55, "rgba(210, 120, 40, 0.6)");
        grad.addColorStop(0.85, "rgba(180, 80, 50, 0.18)");
        grad.addColorStop(1, "rgba(250, 248, 245, 0)");
      }

      renderCtx.save();
      renderCtx.beginPath();
      renderCtx.arc(ballX, ballY, orbRadius, 0, Math.PI * 2);
      renderCtx.fillStyle = grad;
      renderCtx.shadowColor = isDark ? "rgba(235, 165, 80, 0.55)" : "rgba(210, 140, 40, 0.45)";
      renderCtx.shadowBlur = 24;
      renderCtx.fill();

      // 灵兽内圈微光轮廓
      renderCtx.strokeStyle = "rgba(255, 255, 255, 0.4)";
      renderCtx.lineWidth = 1;
      renderCtx.stroke();
      renderCtx.restore();

      // 2. 核心：Pretext 槽位雕刻算法动态排版正文
      renderCtx.font = font;
      renderCtx.fillStyle = isDark ? "#e6e4df" : "#2b2e2b";
      renderCtx.textBaseline = "top";

      let lineTop = 8;

      for (let pIdx = 0; pIdx < preparedParagraphs.length; pIdx++) {
        const prepared = preparedParagraphs[pIdx]!;
        let cursor: LayoutCursor = { segmentIndex: 0, graphemeIndex: 0 };
        let pExhausted = false;

        while (!pExhausted && lineTop < height - lineHeight) {
          const bandTop = lineTop;
          const bandBottom = lineTop + lineHeight;

          // 计算当前行高波段与光球的相交被阻挡区间
          const blocked: Interval[] = [];
          const interval = circleIntervalForBand(ballX, ballY, orbRadius, bandTop, bandBottom, 12, 4);
          if (interval !== null) {
            blocked.push(interval);
          }

          // 核心切槽：将当前行切为左侧和右侧可用槽位
          const slots = carveTextLineSlots({ left: 0, right: width }, blocked, 36);

          if (slots.length === 0) {
            lineTop += lineHeight;
            continue;
          }

          // 从左到右依次填充排版文字
          slots.sort((a, b) => a.left - b.left);

          for (let sIdx = 0; sIdx < slots.length; sIdx++) {
            const slot = slots[sIdx]!;
            const slotWidth = slot.right - slot.left;

            const line = layoutNextLine(prepared, cursor, slotWidth);
            if (line === null) {
              pExhausted = true;
              break;
            }

            renderCtx.fillText(line.text, slot.left, lineTop);
            cursor = line.end;
          }

          lineTop += lineHeight;
        }

        // 段落间距
        lineTop += paragraphGap;
      }

      requestAnimationFrame(render);
    }

    requestAnimationFrame(render);
  }

  document.addEventListener("astro:page-load", initJoyceManuscript);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initJoyceManuscript);
  } else {
    initJoyceManuscript();
  }
</script>
