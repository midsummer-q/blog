---
// PostFluidBanner.astro - 纯净无框的流体交互段落（与原生博客排版无缝融合）
interface Props {
  text: string;
  title?: string;
}

const { text, title } = Astro.props;
const bannerText = text && text.trim().length > 0 
  ? text 
  : `${title ?? "技术随笔"}：记录关于底层逻辑、工程架构设计与编程实践的深度思考。`;
---

<div
  class="post-fluid-banner my-6 w-full select-none"
  data-banner-text={bannerText}
>
  <canvas class="post-banner-canvas block w-full touch-none cursor-pointer"></canvas>
</div>

<script>
  import {
    prepare,
    prepareWithSegments,
    layout,
    layoutNextLineRange,
    materializeLineRange,
    type LayoutCursor,
  } from "@chenglou/pretext";

  function initSeamlessPostBanners() {
    const banners = document.querySelectorAll(".post-fluid-banner");

    banners.forEach(banner => {
      const container = banner as HTMLElement;
      if (container.dataset.initialized === "true") return;
      container.dataset.initialized = "true";

      const canvas = container.querySelector(".post-banner-canvas") as HTMLCanvasElement | null;
      if (!canvas) return;

      const cvs: HTMLCanvasElement = canvas;
      const ctx = cvs.getContext("2d");
      if (!ctx) return;
      const renderCtx: CanvasRenderingContext2D = ctx;

      const rawText = container.dataset.bannerText || "";
      const text = rawText + " （流体交互体验：将鼠标或手指滑过本段文字，文字将如流水般实时避开光球）";

      const font = '16px "Google Sans Code", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif';
      const lineHeight = 30;
      const ballRadius = 40;

      let preparedMeasure = prepare(text, font);
      let preparedHandle = prepareWithSegments(text, font);

      let ballX = 160;
      let ballY = 60;
      let targetX = 160;
      let targetY = 60;
      let autoFloat = true;
      let opacity = 0.85;
      let vx = 1.2;
      let vy = 0.8;

      function resize() {
        const rect = container.getBoundingClientRect();
        const width = rect.width || 600;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);

        // 使用 Pretext 纯数学直接计算段落自然高度
        preparedMeasure = prepare(text, font);
        const { height: calculatedHeight } = layout(preparedMeasure, width, lineHeight);
        const height = Math.max(calculatedHeight + 36, 150);

        cvs.width = width * dpr;
        cvs.height = height * dpr;
        cvs.style.width = `${width}px`;
        cvs.style.height = `${height}px`;

        renderCtx.scale(dpr, dpr);
        preparedHandle = prepareWithSegments(text, font);

        if (ballX > width - ballRadius) ballX = width / 2;
        if (ballY > height - ballRadius) ballY = height / 2;
      }

      resize();
      window.addEventListener("resize", resize);

      function onPointer(e: MouseEvent | TouchEvent) {
        autoFloat = false;
        const rect = cvs.getBoundingClientRect();
        let cx = 0;
        let cy = 0;
        if ("touches" in e) {
          if (e.touches.length > 0) {
            cx = e.touches[0].clientX;
            cy = e.touches[0].clientY;
          }
        } else {
          cx = e.clientX;
          cy = e.clientY;
        }
        targetX = cx - rect.left;
        targetY = cy - rect.top;
      }

      cvs.addEventListener("mousemove", onPointer);
      cvs.addEventListener("touchmove", onPointer, { passive: true });
      cvs.addEventListener("mouseenter", () => { autoFloat = false; });
      cvs.addEventListener("mouseleave", () => { autoFloat = true; });

      function loop() {
        if (!document.body.contains(cvs)) return;

        const rect = cvs.getBoundingClientRect();
        const width = rect.width;
        const height = rect.height;

        const isDark = document.documentElement.classList.contains("dark") || 
                       document.documentElement.getAttribute("data-theme") === "dark";

        if (autoFloat) {
          ballX += vx;
          ballY += vy;
          if (ballX - ballRadius < 0 || ballX + ballRadius > width) vx = -vx;
          if (ballY - ballRadius < 0 || ballY + ballRadius > height) vy = -vy;
          opacity += (0.65 - opacity) * 0.05;
        } else {
          ballX += (targetX - ballX) * 0.16;
          ballY += (targetY - ballY) * 0.16;
          opacity += (0.95 - opacity) * 0.1;
        }

        renderCtx.clearRect(0, 0, width, height);

        // 柔和微光球体（与主题色调相融）
        const grad = renderCtx.createRadialGradient(
          ballX - ballRadius * 0.2,
          ballY - ballRadius * 0.2,
          ballRadius * 0.05,
          ballX,
          ballY,
          ballRadius
        );

        if (isDark) {
          grad.addColorStop(0, `rgba(255, 107, 1, ${0.9 * opacity})`);
          grad.addColorStop(0.5, `rgba(168, 85, 247, ${0.65 * opacity})`);
          grad.addColorStop(1, `rgba(33, 39, 55, 0)`);
        } else {
          grad.addColorStop(0, `rgba(0, 108, 172, ${0.85 * opacity})`);
          grad.addColorStop(0.5, `rgba(99, 102, 241, ${0.5 * opacity})`);
          grad.addColorStop(1, `rgba(253, 253, 253, 0)`);
        }

        renderCtx.save();
        renderCtx.beginPath();
        renderCtx.arc(ballX, ballY, ballRadius, 0, Math.PI * 2);
        renderCtx.fillStyle = grad;
        renderCtx.shadowColor = isDark ? "rgba(255, 107, 1, 0.4)" : "rgba(0, 108, 172, 0.3)";
        renderCtx.shadowBlur = 20;
        renderCtx.fill();
        renderCtx.restore();

        // 纯数学避障文本渲染（无框、天然对齐文章排版）
        if (preparedHandle) {
          renderCtx.font = font;
          renderCtx.fillStyle = isDark ? "#eaedf3" : "#282728";
          renderCtx.textBaseline = "top";

          let cursor: LayoutCursor = { segmentIndex: 0, graphemeIndex: 0 };
          let y = 6;
          const availableW = width;

          while (y < height - lineHeight + 4) {
            const midY = y + lineHeight / 2;
            const dy = Math.abs(midY - ballY);

            let lineStartX = 0;
            let lineWidth = availableW;

            if (dy < ballRadius + 4) {
              const dx = Math.sqrt(Math.max(0, Math.pow(ballRadius + 8, 2) - dy * dy));
              const obsLeft = ballX - dx;
              const obsRight = ballX + dx;

              const leftRoom = Math.max(0, obsLeft);
              const rightRoom = Math.max(0, width - obsRight);

              if (leftRoom > rightRoom && leftRoom > 80) {
                lineStartX = 0;
                lineWidth = leftRoom;
              } else if (rightRoom > 80) {
                lineStartX = obsRight;
                lineWidth = rightRoom;
              }
            }

            const range = layoutNextLineRange(preparedHandle, cursor, lineWidth);
            if (!range) break;

            const line = materializeLineRange(preparedHandle, range);
            renderCtx.fillText(line.text, lineStartX, y);

            cursor = range.end;
            y += lineHeight;
          }
        }

        requestAnimationFrame(loop);
      }

      requestAnimationFrame(loop);
    });
  }

  document.addEventListener("astro:page-load", initSeamlessPostBanners);
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initSeamlessPostBanners);
  } else {
    initSeamlessPostBanners();
  }
</script>
