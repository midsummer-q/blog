---
import config from "@/config";

const { analytics } = config;
const umami = analytics?.umami;
const googleAnalytics = analytics?.googleAnalytics;
const gaId = googleAnalytics?.id;
---

{
  umami?.websiteId && (
    <script
      is:inline
      defer
      src={umami.scriptUrl ?? "https://cloud.umami.is/script.js"}
      data-website-id={umami.websiteId}
      data-domains={umami.domains}
    />
  )
}

{
  gaId && (
    <script
      is:inline
      async
      src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}
    />
  )
}

{
  gaId && (
    <div
      id="ga-init-marker"
      data-ga-id={gaId}
      class="hidden"
      aria-hidden="true"
    />
  )
}

<script is:inline>
  const gaMarker = document.getElementById("ga-init-marker");
  const gaIdVal = gaMarker?.getAttribute("data-ga-id");
  if (gaIdVal) {
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      window.dataLayer.push(arguments);
    }
    gtag("js", new Date());
    gtag("config", gaIdVal);

    document.addEventListener("astro:page-load", () => {
      gtag("event", "page_view", {
        page_title: document.title,
        page_location: window.location.href,
        page_path: window.location.pathname,
      });
    });
  }
</script>
