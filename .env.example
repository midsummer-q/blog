# 部署服务器配置模板
# 复制此文件为 .env 并填入实际值（.env 已被 .gitignore 忽略，切勿提交敏感密码）

# 服务器地址与端口
DEPLOY_HOST=39.105.13.58
DEPLOY_PORT=22
DEPLOY_USER=root

# 认证方式（二选一即可，推荐使用 SSH 密钥）：
# 方式 A：SSH 私钥文件路径（推荐）
# DEPLOY_KEY_FILE=C:/Users/your_name/.ssh/id_rsa

# 方式 B：服务器密码（若留空，脚本运行时将在终端提示输入）
# DEPLOY_PASSWORD=your_secure_password_here

# 服务器目标站点目录
DEPLOY_TARGET_DIR=/var/www/astro
